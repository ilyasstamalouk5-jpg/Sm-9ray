# Copy these into your host's "Environment variables" page.
# Never commit real values to GitHub.

# Required
# (DISCORD_BOT_TOKEN is also accepted as the name of the token variable)
DISCORD_TOKEN=
DATABASE_URL=
# The ONE Discord server this bot serves (right-click the server > Copy Server ID)
TARGET_GUILD_ID=

# Optional: the server (guild) that has your milestone roles
MILESTONE_GUILD_ID=

# Optional: one Discord role ID per milestone (1 = 1h ... 10 = 150h)
MILESTONE_ROLE_1=
MILESTONE_ROLE_2=
MILESTONE_ROLE_3=
MILESTONE_ROLE_4=
MILESTONE_ROLE_5=
MILESTONE_ROLE_6=
MILESTONE_ROLE_7=
MILESTONE_ROLE_8=
MILESTONE_ROLE_9=
MILESTONE_ROLE_10=

# Optional: channel where "Congratulations!" milestone cards are posted
# (right-click the channel > Copy Channel ID). Leave empty for no announcements.
# MILESTONE_ANNOUNCE_CHANNEL_ID=
# Emoji in front of each line of that announcement
# MILESTONE_BULLET=🏆

# Optional: how often milestones are checked (minimum 10000)
# MILESTONE_CHECK_INTERVAL_MS=30000

# Optional: log detail (debug, info, warn, error)
# LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Dirham economy. Everything below is optional: the values shown are the
# defaults built into the bot, so you only set one to change it.
# ---------------------------------------------------------------------------

# Optional: members with this role can use /economy-admin (Administrators always can)
# ADMIN_ROLE_ID=

# Optional: direct https link to the currency image (PNG/JPEG/GIF/WebP, max 5 MB).
# Admins can also change it from Discord with /economy-admin image-set.
# CURRENCY_IMAGE_URL=

# CURRENCY_NAME=Dirham
# CURRENCY_NAME_PLURAL=Dirhams
# CURRENCY_SYMBOL=DH
# CURRENCY_EMOJI=🪙
# STARTING_BALANCE=0

# Voice rewards (AFK channels count)
# VOICE_REWARD_AMOUNT=50
# VOICE_REWARD_INTERVAL_MINUTES=60

# /transfer: transfers between members. Tax is a percent of the amount (rounded down).
# PAY_TAX_PERCENT=5
# PAY_MIN_AMOUNT=10
# PAY_MAX_AMOUNT=100000

# WORK_REWARD_AMOUNT=400
# WORK_COOLDOWN_HOURS=4
# DAILY_REWARD_AMOUNT=1000
# DAILY_COOLDOWN_HOURS=24

# Wager limits, and the most any single game can ever pay out
# MIN_BET=10
# MAX_BET=10000
# MAX_GAME_PAYOUT=1000000

# Game rules
# COINFLIP_PAYOUT_PERCENT=195          (total returned: 195 = 1.95x the wager)
# MINES_DEFAULT_COUNT=3
# MINES_MAX_COUNT=10
# MINES_HOUSE_EDGE_PERCENT=3
# APPLE_TOWER_LEVELS=8
# APPLE_TOWER_HOUSE_EDGE_PERCENT=3
# BLACKJACK_NATURAL_PAYOUT_PERCENT=150 (150 = 3:2)
# BLACKJACK_DEALER_HITS_SOFT_17=false
# GAME_TIMEOUT_MINUTES=10

# Guessing games (/guessflag, /guessmap, /guesslogo): faster answers pay more
# QUIZ_MIN_REWARD=40
# QUIZ_MAX_REWARD=70
# QUIZ_TIME_LIMIT_SECONDS=15
# QUIZ_COOLDOWN_SECONDS=30

# One-time Dirham reward per milestone (1 = 1h ... 10 = 150h). Leave empty for none.
# MILESTONE_CURRENCY_REWARD_1=
# MILESTONE_CURRENCY_REWARD_2=
# MILESTONE_CURRENCY_REWARD_3=
# MILESTONE_CURRENCY_REWARD_4=
# MILESTONE_CURRENCY_REWARD_5=
# MILESTONE_CURRENCY_REWARD_6=
# MILESTONE_CURRENCY_REWARD_7=
# MILESTONE_CURRENCY_REWARD_8=
# MILESTONE_CURRENCY_REWARD_9=
# MILESTONE_CURRENCY_REWARD_10=

# Time zone that decides where a day ends on the /voicestats activity card
# (an IANA name such as Africa/Casablanca). Default: UTC.
ACTIVITY_TIMEZONE=
